[Plymouth Theme]
Name=Lenovo GNOME Theme
Description=Lenovo brand boot splash (unofficial): wallpaper or dark background, white spinner, Signature Red progress
ModuleName=two-step

[two-step]
Font=@FONT@ 12
TitleFont=@FONT@ Bold 30
ImageDir=/usr/share/plymouth/themes/lenovo-gnome-theme
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.7
Transition=none
TransitionDuration=0.0
BackgroundStartColor=@BGCOLOR@
BackgroundEndColor=@BGCOLOR@
ProgressBarBackgroundColor=0x4E444E
ProgressBarForegroundColor=0xE1251B
MessageBelowAnimation=true
ScaleBackgroundImage=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
