# Lenovo — btop theme built from the Lenovo brand palette (matches Ghostty "Lenovo" theme)
#   Signature Red #E1251B · Accent Reds #F26A52 / #B8252E / #871C23 · Pale Gray #E6E2E4
#   Deep Purple 2 #7A126B · Pale Purple 1 #D9C1D8 · neutral dark greys to match the GTK overrides.
#   Green/blue/yellow are derived, not Lenovo.

theme[main_bg]="#1C1A1C"
theme[main_fg]="#E6E2E4"
theme[title]="#FFFFFF"
theme[hi_fg]="#F26A52"
theme[selected_bg]="#871C23"
theme[selected_fg]="#FFFFFF"
theme[inactive_fg]="#6E6A6E"
theme[graph_text]="#ABA8B1"
theme[meter_bg]="#3A363A"
theme[proc_misc]="#F26A52"

theme[cpu_box]="#4A464A"
theme[mem_box]="#4A464A"
theme[net_box]="#4A464A"
theme[proc_box]="#4A464A"
theme[div_line]="#3A363A"

# Load gradients: green (low) -> yellow -> Signature Red (high), so red only means "high".
# Green and yellow are derived (Lenovo has none); they match the Ghostty palette.
theme[temp_start]="#6CC49A"
theme[temp_mid]="#F2B84B"
theme[temp_end]="#E1251B"
theme[cpu_start]="#6CC49A"
theme[cpu_mid]="#F2B84B"
theme[cpu_end]="#E1251B"
theme[used_start]="#6CC49A"
theme[used_mid]="#F2B84B"
theme[used_end]="#E1251B"

theme[free_start]="#3E7A5E"
theme[free_mid]="#6CC49A"
theme[free_end]="#A6E3C4"
theme[cached_start]="#3D5A99"
theme[cached_mid]="#6F8FD6"
theme[cached_end]="#C9D0F0"
theme[available_start]="#6E6A6E"
theme[available_mid]="#ABA8B1"
theme[available_end]="#E6E2E4"

theme[download_start]="#3D5A99"
theme[download_mid]="#6F8FD6"
theme[download_end]="#C9D0F0"
# Upload: Lenovo purples, so network traffic never looks like a warning
theme[upload_start]="#7A126B"
theme[upload_mid]="#B45AA6"
theme[upload_end]="#D9C1D8"

theme[process_start]="#6CC49A"
theme[process_mid]="#F2B84B"
theme[process_end]="#E1251B"
